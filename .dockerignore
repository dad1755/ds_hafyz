# Keep the build context small and secret-free.
.git
.gitignore
.dockerignore

# secrets — never sent to the daemon
.env
.env.*
!.env.example
!.env.cloudflared.example
PROJECT_DETAILS.md

# runtime state and uploads (mounted, never baked in)
storage/
data/quarantine/
*.db
*.db-wal
*.db-shm
logs/
evidence/

# model artifacts: the three read-only files the app needs are shipped (blueprint §7 —
# "copy only code, read-only model artifacts and config"); candidates, EDA output and
# figures are regenerated by ml/train.py, ml/evaluate.py and ml/generate_eda.py and stay out.
models/*
!models/best_pipeline.joblib
!models/model_manifest.json
!models/metrics.json

# documentation and drafting material
docs/
*.md
*.docx

# tests are not part of the runtime image
tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
