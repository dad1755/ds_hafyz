# Keep the build context small and secret-free.
.git
.gitignore
.dockerignore

# secrets — never sent to the daemon
.env
.env.*
!.env.example
!.env.cloudflared.example
PROJECT_DETAILS.md

# runtime state and uploads (mounted, never baked in)
storage/
data/quarantine/
*.db
*.db-wal
*.db-shm
logs/
evidence/

# model artifacts: the read-only files the app needs are shipped (blueprint §7 — "copy only
# code, read-only model artifacts and config"). The trained candidates stay out; the EDA
# figures, the confusion matrices and the aggregate summary they were drawn from ship with the
# image, because the admin evaluation page (S10) displays them as artifacts and never redraws
# them from a statistic of its own.
models/*
!models/best_pipeline.joblib
!models/model_manifest.json
!models/metrics.json
!models/eda
!models/figures

# documentation and drafting material
docs/
*.md
*.docx

# tests are not part of the runtime image
tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
