# AI Hub Campus — application environment (PLACEHOLDERS ONLY).
# Copy to .env and replace every REPLACE_WITH_* value, then: chmod 600 .env
# The Cloudflare tunnel token is NOT read from this file — see .env.cloudflared.example.
# Never commit the filled-in .env; it is git-ignored.

APP_ENV=production
APP_DOMAIN=www.aihubcampus.online
# Must match the tunnel ingress target (http://web:2026) and .streamlit/config.toml.
APP_PORT=2026

# Seeded once in Sprint 6; the app reads these, it never invents credentials.
INITIAL_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_OPERATOR_PASSWORD
INITIAL_USER_USERNAME=REPLACE_WITH_DEMO_USER_USERNAME
INITIAL_USER_PASSWORD=REPLACE_WITH_STRONG_DEMO_USER_PASSWORD

APP_SESSION_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET
DATA_RETENTION_DAYS=30
